#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATASET_ROOT="${DATASET_ROOT:-${ROOT}/datasets/data_act_balanced_140}"
OUTPUT_DIR="${OUTPUT_DIR:-${ROOT}/outputs/train/dp_fr3_balanced_140}"
STEPS="${STEPS:-5000}"
BATCH_SIZE="${BATCH_SIZE:-8}"

if [[ ! -f "${DATASET_ROOT}/meta/info.json" ]]; then
  echo "Missing dataset: ${DATASET_ROOT}" >&2
  exit 1
fi
if ! python3 - <<'PY'
try:
    import accelerate, diffusers
except ImportError:
    raise SystemExit(1)
PY
then
  echo "Install dependencies: python3 -m pip install accelerate diffusers" >&2
  exit 1
fi
if ! python3 - <<'PY'
import torch
print(f"CUDA available: {torch.cuda.is_available()}")
raise SystemExit(0 if torch.cuda.is_available() else 1)
PY
then
  echo "CUDA is not available." >&2
  exit 1
fi
cd "${ROOT}"
export PYTHONPATH="${ROOT}/lerobot/src${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m lerobot.scripts.lerobot_train \
  --policy.type=diffusion \
  --dataset.repo_id=local/fr3_block_push_dp_balanced \
  --dataset.root="${DATASET_ROOT}" \
  --output_dir="${OUTPUT_DIR}" \
  --job_name=dp_fr3_balanced_140 \
  --policy.device=cuda \
  --policy.horizon=64 \
  --policy.n_obs_steps=2 \
  --policy.n_action_steps=32 \
  --policy.push_to_hub=false \
  --steps="${STEPS}" \
  --batch_size="${BATCH_SIZE}" \
  --wandb.enable=false
